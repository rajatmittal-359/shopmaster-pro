# ShopMaster Pro - backend environment
#
# Copy to .env and fill in real values. This file is committed on purpose:
# it is the list of what the app needs, with no secrets in it.
#
# Every key below is read somewhere in the code. If you add a key here, make
# sure something actually uses it - and if you add one to the code, add it here.

# ---- Core ------------------------------------------------------------------
MONGO_URI=
JWT_SECRET=
PORT=5000
NODE_ENV=development

# Where the SITE lives, as opposed to this API. Used to build the password
# reset link: the API and the site are different origins in every environment,
# so a link built from the incoming request would point at the API and 404 in
# the person's browser. No trailing slash needed - one is stripped either way.
# Defaults to http://localhost:5173 when unset, which is right for local work
# and wrong everywhere else, so set it on Render.
FRONTEND_URL=https://www.shopmasterpro.in

# ---- Email (Brevo) ---------------------------------------------------------
# Sent over Brevo's REST API - no SDK, no extra dependency.
# Free tier is 300 emails/day, which covers OTPs, order and shipping notices.
# The sender domain must be authenticated in Brevo, or mail lands in spam.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@shopmasterpro.in
# Optional. The name a customer sees as the sender. Defaults to "ShopMaster Pro".
BREVO_FROM_NAME=

# ---- Payments (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the secret set on the webhook in the Razorpay dashboard, or every
# webhook signature check fails.
RAZORPAY_WEBHOOK_SECRET=

# ---- Images (Cloudinary) ---------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Courier: standard delivery (Shiprocket) -------------------------------
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
# The shop's own pincode. The local-vs-national shipping split is worked out by
# comparing the first three digits of this against the delivery pincode.
SHIPROCKET_PICKUP_PINCODE=302019
# Must match the pickup location NAME in Shiprocket exactly. Defaults to
# "Primary" - if your location is named anything else, every booking fails.
SHIPROCKET_PICKUP_LOCATION=Primary

# ---- Courier: same-day delivery (Borzo) ------------------------------------
# Same-day is only offered for addresses in the pickup pincode's own district.
BORZO_API_TOKEN=
BORZO_ENV=production
BORZO_PICKUP_ADDRESS=
BORZO_PICKUP_PHONE=

# ---- Optional --------------------------------------------------------------
# Used by generateSitemap.js. Defaults to https://www.shopmasterpro.in
SITE_URL=
# Used by seed.js for the demo accounts. A strong one is generated if unset.
SEED_DEMO_PASSWORD=
# Who the seed / migrateToProd / evalAssistant scripts treat as the admin and
# the house shop's seller. Never committed - the public repo must not say which
# seller the operator runs. Defaults are placeholders (admin@example.com …).
SEED_ADMIN_EMAIL=
SEED_SELLER_EMAIL=
SEED_CUSTOMER_EMAIL=
SEED_HOUSE_SHOP=
# Display names for the three demo accounts (defaults: Admin Demo / Seller Demo / Customer Demo)
SEED_ADMIN_NAME=
SEED_SELLER_NAME=
SEED_CUSTOMER_NAME=

# Shiprocket pushes tracking updates to POST /api/logistics/track and
# authenticates with this value in an x-api-key header. Set the SAME string in
# Shiprocket: Settings > API > Webhooks. Without it every update is rejected -
# deliberately, since an unset token would mean "accept anything", and anyone
# could then mark an order delivered and release a payout.
SHIPROCKET_WEBHOOK_TOKEN=

GOOGLE_SA_KEY_FILE=../private/google-service-account.json   # or GOOGLE_SA_KEY_JSON with the file contents
GSC_SITE=sc-domain:shopmasterpro.in
MERCHANT_CENTER_ID=5849184820

# Ask ShopMaster fallback chain: Gemini (tools + web) -> Groq (tools, free, console.groq.com) -> Pollinations nano (prose only)
GROQ_API_KEY=

# Sentry (free Developer plan) - errors only, no bodies/headers sent. Empty = off.
SENTRY_DSN=

# Cutover switch (plan 2.29): once the old React app is gone, a return request
# without a `kind` is refused instead of taken as before. Set to true on Render
# the day the domain moves to the Next app.
RETURN_KIND_REQUIRED=false

# Sarvam AI (plan 2.37d / 2.27): Indic speech-to-text road after Groq, and the
# one-time Learn lesson audio (node generateLessonAudio.js). ₹100 free credits;
# STT ₹30/hour billed per second, TTS ₹30 per 10k characters. Off when unset.
SARVAM_API_KEY=

# Cloudflare Turnstile (plan 2.28): bot check on /auth/register and /auth/become-seller.
# Secret here; the public site key goes in web/.env.local as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
# Off when unset.
TURNSTILE_SECRET=

# IndexNow: the key file web/public/<key>.txt must contain this value (public by design).
INDEXNOW_KEY=

# Extra browser origins the API answers (staging web before the domain moves), comma-separated exact origins.
EXTRA_ORIGINS=

# Meta Conversions API: the server-side copy of Purchase, deduped against the
# browser pixel (web: NEXT_PUBLIC_META_PIXEL_ID). Events Manager > Data sources
# > the pixel > Settings > Conversions API > Generate access token. Only sent
# when the visitor chose "Accept all" (smp_consent cookie). Off when unset.
META_PIXEL_ID=
META_CAPI_TOKEN=
# From Events Manager > Test events while checking the wiring; remove after.
META_TEST_EVENT_CODE=

# Settings save -> storefront cache dropped at once (utils/webRevalidate, 2.56).
# Same value as REVALIDATE_TOKEN on the web server; WEB_INTERNAL_URL is
# http://web:3000 in deploy/compose.yml. Both optional - without them the
# storefront re-reads settings every 30 s.
WEB_REVALIDATE_TOKEN=
WEB_INTERNAL_URL=
