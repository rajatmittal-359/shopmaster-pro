# Caddy in front of the two containers (20 Sep 2026). Automatic HTTPS from
# Let's Encrypt for every host named here; HTTP → HTTPS by default.
#
# Before the DNS points here, Caddy cannot get a certificate - that is
# expected; it retries on its own once the A records land (OPS cutover steps).
# To try the box by IP first, run: SITE_HOST=":80" (then no TLS).

{
	email rajatmittal359@gmail.com
	# One box, one origin: no need for Caddy's admin API to listen at all.
	admin off
}

# The apex redirects to www, so every page has one canonical URL (Google,
# Razorpay and the OG cards were all told www).
{$APEX_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST} {
	encode zstd gzip

	# Security headers the app expects a proxy to add (helmet covers the API).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The API, same origin: cookies stay first-party (utils/auth/session), the
	# Razorpay and Shiprocket webhooks post here, and Next's own /api rewrite
	# is never reached because this rule wins first.
	handle /api/* {
		reverse_proxy api:5000 {
			# The API reads the real client address for rate limits and the AuthEvent log.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# The sitemap is built by the API from the catalogue (next.config rewrites it in dev).
	handle /sitemap.xml {
		rewrite * /api/sitemap.xml
		reverse_proxy api:5000
	}

	# Everything else is the Next.js site.
	#
	# DEPLOYS USED TO SERVE 502s (fixed 26 Sep 2026). `release.sh` recreates the
	# web container, which gets a NEW address on the docker network. Caddy had
	# already resolved `web` once and kept that address, so for the few seconds
	# between the old container going and the new one being reachable, every
	# request failed - and the ones that caught it in the log were Googlebot's
	# and GPTBot's, which is an indexing risk, not just an ugly log:
	#   dial tcp 172.18.0.3:3000: connect: connection refused
	#   dial tcp: lookup web on 127.0.0.11:53: server misbehaving
	#
	# `dynamic a` re-resolves the name against Docker's DNS instead of caching
	# it, and lb_try_duration makes Caddy wait and retry through the swap
	# rather than answering 502 on the first refusal. release.sh already waits
	# for both health checks, so this closes the only remaining gap - Caddy's
	# own view of where the container lives.
	handle {
		reverse_proxy {
			dynamic a {
				name web
				port 3000
				refresh 1s
			}
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
