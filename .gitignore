# Dependencies
node_modules/
# package-lock.json was ignored here, which defeats the point of a lockfile:
# CI and this machine could install different versions and disagree about
# whether the tests pass. Lockfiles belong in git.

# Environment variables
.env
.env.*
!.env.example
.env.local
.env.production

# Credentials / tokens - never commit
bearertoken.txt
*.tok

# Local tooling
# Local Claude settings stay out; the project's rules for the user-level skills are part of the repo
.claude/*
!.claude/project-rules/

# Build outputs
dist/
build/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
.playwright-mcp/


# Operational notes - account IDs and personal contact details, local only
OPS-AND-MANUAL-ACTIONS.md
testcredentails.txt
brevodomain.txt

# Working analysis docs - local only, deleted once their findings are acted on
ARCHITECTURE-GAP-ANALYSIS.md
CODE-STRUCTURE-REVIEW.md
UI-UX-GAP-ANALYSIS.md

# The undo record for draftProductDescriptions.js - generated, and local to
# whoever ran it. Re-running rewrites it wholesale.
backend/drafted-descriptions.json

# Belt and braces for a PUBLIC repository.
#
# Nothing sensitive has ever been committed here - 151 commits were scanned and
# the only hit was a doc mentioning the string "rzp_live_", not a key. These
# patterns exist so that stays true by accident as well as on purpose: `git add
# -A` is run often, and on a public repo one careless add is permanent.
*credential*
*credentials*
*.pem
*.key
*secret*
*token*.txt

# Screenshots taken while checking work in the browser. They are evidence for
# one session, not part of the project.
*.png
!web/public/**/*.png
!web/src/app/icon.png
!web/src/app/apple-icon.png

# Reference clone, read for its DESIGN.md format - not part of the project

# Local-only folders (12 Sep 2026): credentials and superseded working documents
private/
docs/archive/
